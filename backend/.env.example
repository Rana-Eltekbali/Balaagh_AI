APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Enabled by default; never disable for a public demo. Required: 32-512 ASCII characters.
# Generate privately into the ignored .env, never a VITE_* variable or frontend build.
DEMO_AUTH_ENABLED=true
DEMO_API_TOKEN=

# Supabase direct connection or session pooler; never commit the filled .env.
DATABASE_URL=
DATABASE_SSL=false
# Optional trusted project CA certificate PEM; supplements system trust when SSL is enabled.
DATABASE_SSL_CA_FILE=
DATABASE_POOL_SIZE=5

# Existing multi-task AraBERT: set both classifier paths to the SAME directory.
# That directory must include the trained multitask_model.pt checkpoint.
CATEGORY_MODEL_PATH=
PRIORITY_MODEL_PATH=
LOCATION_MODEL_PATH=
MODEL_DEVICE=cpu
INFERENCE_MODE=real
INFERENCE_MAX_CONCURRENCY=1
INFERENCE_QUEUE_TIMEOUT_SECONDS=30
CLASSIFICATION_MAX_TOKENS=128
LOCATION_MAX_TOKENS=128

LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=
# OpenAI-compatible API prefix, e.g. https://provider.example/v1 (not /chat/completions).
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=15

CORS_ORIGINS=http://localhost:5173
REPORTS_TIMEZONE=Africa/Tripoli
MODEL_EVALUATION_JSON=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required and stable across restarts in production; minimum 32 characters.
ANALYSIS_SIGNING_KEY=
ANALYSIS_TOKEN_TTL_SECONDS=86400
REQUEST_MAX_BYTES=262144
